# Loaded only when running `npm run dev`. Overrides `.env` for Vite.
# Use the dev-server proxy in vite.config.ts so BMS requests are same-origin (no CORS).
VITE_BMS_API_URL=/api/call-center
VITE_BMS_SUPPORT_CHAT_API_URL=/api/support-chat
# Auth API: leave unset in dev → `/api/auth/*` proxied to http://127.0.0.1:5000
# VITE_AUTH_API_URL=http://127.0.0.1:5000
